# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
dist-release/
build/

# Packaging Binaries & Archives (Avoid committing 35MB+ binaries to git history)
*.exe
*.zip
*.tar.gz
*.7z

# Windows Desktop Shortcuts & Local System files
*.lnk
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS & Linux system files
.DS_Store
.AppleDouble
.LSOverride
._*

# Logs & Audit Dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Local Secrets (Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Local IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary / Scratch Files
scratch/
tmp/
temp/
